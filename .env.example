# claudiomendonca.com — environment variables
#
# Copy to `.env` for local work, or set these in the Netlify site config
# (Site settings → Environment variables) for deploy previews + production.
# Nothing here is committed with real values.

# --- Newsletter signup (PRO-179) -------------------------------------------
# Used ONLY by the Netlify Function netlify/functions/newsletter-subscribe.ts.
# They are server-side secrets — never expose them to the client bundle (do not
# prefix with NUXT_PUBLIC_ or read them in Vue components).
#
# Without both set, the function returns a 500 `server_misconfigured` and the
# NewsletterBand surfaces its generic error state. That is the EXPECTED local
# behaviour — end-to-end sign-up is verified on a Netlify deploy preview with
# the real values, not locally.

# Resend API key (https://resend.com/api-keys). Server-side only.
RESEND_API_KEY=

# Resend Audience UUID to add new contacts to (Resend → Audiences → the
# audience's ID). Despite the "SEGMENT" name this is the Resend *audience* id
# passed to resend.contacts.create({ audienceId }).
RESEND_SEGMENT_ID=
